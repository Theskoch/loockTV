{
  "name": "lookit-client",
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.lookit.client",
    "productName": "LoockIT",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "LoockIT-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LoockIT-Setup.exe"
    },
    "files": ["src/**/*"],
    "publish": {
      "provider": "github",
      "owner": "Theskoch",
      "repo": "loockTV"
    }
  }
}
